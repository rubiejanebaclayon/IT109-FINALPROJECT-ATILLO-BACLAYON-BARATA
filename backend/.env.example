(venv) PS ...\student-gig-marketplace\backend># ---- Copy this file to ".env" and fill in your own values. NEVER commit .env ----

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=720
TRUST_PROXY=false

# Supabase PostgreSQL (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Storage (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=portfolio

# Upstash Redis (REST API tab). Leave blank to use the in-memory fallback cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated email domains allowed to sign in (blank = any Google account)
ALLOWED_EMAIL_DOMAINS=

# CAPTCHA (Google reCAPTCHA v2 checkbox; use Google's published test keys while developing)
CAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=

# PayMongo (sandbox / test keys only: sk_test_..., whsk_...)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10

# Google SMTP (use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Student Gig Marketplace
